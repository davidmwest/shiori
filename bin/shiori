#!/bin/sh
# Shiori command-line tools. Uses Node.js when installed; otherwise the
# JavaScriptCore engine that ships with macOS. No installation needed.

# The engine folder. Follow symlinks: npm link / npm install -g, or a manual
# `ln -s .../bin/shiori /usr/local/bin/shiori`, run this script through one.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
HERE="$(cd -P "$(dirname "$SELF")" && pwd -P)"
ROOT="$(dirname "$HERE")"
CLI="$ROOT/tools/cli.js"

# Quote a word so it can be pasted into a shell (only when it needs it).
shq() {
  case "$1" in
    '' | *[!A-Za-z0-9_./@%+=:,-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
    *) printf '%s' "$1" ;;
  esac
}

if [ "$1" = "new" ]; then
  DEST="$2"
  if [ -z "$DEST" ]; then echo "Usage: shiori new <folder>" >&2; exit 2; fi
  if [ -e "$DEST" ]; then echo "shiori: $DEST already exists" >&2; exit 1; fi
  mkdir -p "$(dirname "$DEST")" && cp -R "$ROOT/templates/new-game" "$DEST" || exit 1
  Q="$(shq "$DEST")"
  echo "Created $DEST. Next:"
  echo "  shiori check $Q      # compile and lint"
  echo "  shiori play $Q       # read it in the terminal"
  echo "  shiori serve $Q      # play it in a browser (the folder must be inside the engine folder)"
  exit 0
fi

if [ "$1" = "build" ]; then
  GAMEDIR="$2"; DEST="$3"
  if [ -z "$GAMEDIR" ] || [ -z "$DEST" ]; then echo "Usage: shiori build <game-folder> <output-folder>" >&2; exit 2; fi
  [ -f "$GAMEDIR/game.story" ] || { echo "shiori build: $GAMEDIR has no game.story" >&2; exit 1; }
  [ -e "$DEST" ] && { echo "shiori build: $DEST already exists" >&2; exit 1; }
  "$HERE/shiori" check "$GAMEDIR" >/dev/null || { echo "shiori build: the game has errors; run: shiori check $(shq "$GAMEDIR")" >&2; exit 1; }
  mkdir -p "$DEST/engine" || exit 1
  cp -R "$ROOT/engine/core" "$ROOT/engine/runtime" "$ROOT/engine/vendor" "$DEST/engine/"
  rm -f "$DEST/engine/runtime/three/test.html"
  (cd "$GAMEDIR" && tar cf - --exclude '.git' --exclude 'private' --exclude '*.md' .) | (mkdir -p "$DEST/game" && cd "$DEST/game" && tar xf -)
  sed 's|<div id="shiori"></div>|<div id="shiori" data-game="game"></div>|' "$ROOT/player.html" > "$DEST/index.html"
  cp "$ROOT/LICENSE" "$DEST/ENGINE-LICENSE.txt"
  echo "Built $DEST — upload the whole folder to any static host (itch.io: zip it as an HTML game)."
  echo "Test it: cd $(shq "$DEST") && python3 $(shq "$ROOT/tools/serve.py") 8780   then open http://localhost:8780/"
  exit 0
fi

if [ "$1" = "selftest" ]; then
  cd "$ROOT" || exit 1
  set -- __selftest
fi

if [ "$1" = "serve" ]; then
  # The folder given, else the current folder if it is a game, else the example.
  if [ -n "$2" ]; then GAMEDIR="$2"
  elif [ -f game.story ]; then GAMEDIR=.
  else GAMEDIR="$ROOT/examples/lantern-keeper"; fi
  PORT="${PORT:-8777}"
  [ -d "$GAMEDIR" ] || { echo "shiori serve: no folder $GAMEDIR." >&2; exit 1; }
  [ -f "$GAMEDIR/game.story" ] || { echo "shiori serve: $GAMEDIR has no game.story. Pass the folder that holds it: shiori serve games/my-game" >&2; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "shiori serve: needs python3." >&2; exit 2; }
  ABS="$(cd "$GAMEDIR" && pwd -P)"
  case "$ABS" in
    "$ROOT"/*) REL="${ABS#"$ROOT"/}" ;;
    *) echo "shiori serve: $GAMEDIR is outside the engine folder ($ROOT). Move or copy it inside, so one web server can serve both." >&2; exit 1 ;;
  esac
  URLREL="$(python3 -I -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$REL")"
  echo "Serving $ROOT"
  echo "Open: http://localhost:$PORT/player.html?game=$URLREL&dev=1"
  cd "$ROOT" && exec python3 "$ROOT/tools/serve.py" "$PORT"
fi

if [ "$1" = "__selftest" ]; then CLI="$ROOT/tests/run.js"; shift; fi
if command -v node >/dev/null 2>&1; then exec node "$CLI" "$@"; fi

JSC=/System/Library/Frameworks/JavaScriptCore.framework/Versions/Current/Helpers/jsc
if [ ! -x "$JSC" ]; then
  echo "shiori: needs Node.js (https://nodejs.org) or macOS's JavaScriptCore." >&2
  exit 2
fi

INFO="$(mktemp -t shiori.XXXXXX)" || exit 1
OUT="$(mktemp -t shiori.XXXXXX)" || exit 1
ERR="$(mktemp -t shiori.XXXXXX)" || exit 1
trap 'rm -f "$INFO" "$OUT" "$ERR"' EXIT
trap 'exit 130' INT TERM

# JavaScriptCore can neither list folders nor read its arguments as UTF-8, so
# write a file it can read (format: parseHostInfo in tools/host.js): the current
# folder, the files of every folder named on the command line (the CLI decides
# which one is the game), and the folders next to any path that does not exist.
list_dir() {
  printf 'dir %s\n' "$1"
  (cd "$1" 2>/dev/null && find -L . \( -name .git -o -name node_modules \) -prune -o -type f -exec /usr/bin/stat -L -f 'f %d:%i %N' {} + 2>/dev/null)
}
{
  printf 'cwd %s\n' "$PWD"
  first=1; parents=""
  for a in "$@"; do
    if [ $first -eq 1 ]; then first=0; continue; fi
    case "$a" in --*=*) v="${a#*=}" ;; --*) continue ;; *) v="$a" ;; esac
    v="${v%/}"
    [ -n "$v" ] || continue
    if [ -d "$v" ]; then list_dir "$v"; continue; fi
    case "$v" in */*) p="${v%/*}"; [ -n "$p" ] || p=/ ;; *) p=. ;; esac
    case "$parents" in *"
$p
"*) continue ;; esac
    parents="$parents
$p
"
    if [ -d "$p" ]; then
      printf 'parent %s\n' "$p"
      for d in "$p"/*/; do [ -d "$d" ] && printf 'sub %s\n' "$(basename "$d")"; done
    fi
  done
  [ -f game.story ] && list_dir .
} > "$INFO"

"$JSC" -m "$CLI" -- --host-info "$INFO" "$@" >"$OUT" 2>"$ERR"
status=$?
# jsc has no exit(); the CLI ends with a marker exception carrying the code.
code=$(grep '^Exception: Error: __shiori_exit_[0-9]*$' "$OUT" | tail -1 | sed 's/.*__shiori_exit_//')
sed '/^Exception: Error: __shiori_exit_[0-9]*$/,$d' "$OUT"
# readFile() reports every missing file on stderr; the CLI reports them itself.
grep -v '^Could not open file: ' "$ERR" >&2
if [ -n "$code" ]; then exit "$code"; fi
exit $status
