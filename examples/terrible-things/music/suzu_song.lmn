section C_Ten bars=4
// the summit: E6 over A with bells, timpani and harp sweeps
strings     | !ff D6h B5q D6q | E6h. D6q | !f B5q. A5e F#5q A5q | B5w |
strings.s2  | !ff D5h B4q D5q | E5h. D5q | !f B4q. A4e F#4q A4q | B4w |
